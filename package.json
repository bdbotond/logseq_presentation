{
  "name": "logseq-presentation",
  "version": "1.0.0",
  "description": "Logseq plugin to convert pages into presentations, manage slide decks in a side panel, and export to HTML/PDF",
  "author": "bdbotond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bdbotond/logseq_presentation"
  },
  "main": "dist/index.html",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "logseq": {
    "id": "logseq-presentation",
    "title": "Presentation",
    "icon": "icon.png"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "presentation",
    "slides",
    "deck",
    "export"
  ],
  "dependencies": {
    "@logseq/libs": "^0.0.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.11",
    "marked": "^15.0.0",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.0"
  }
}
